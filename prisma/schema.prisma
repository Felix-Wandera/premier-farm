// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =======================
// User Management
// =======================
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  firstName String?
  lastName  String?
  phoneNumber String?
  password  String // Hashed password
  role      Role      @default(WORKER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Password Reset
  resetToken    String?
  resetTokenExp DateTime?

  // Invitation Flow
  inviteToken    String? @unique
  inviteTokenExp DateTime?

  // Relations
  memberships TenantUser[]
  expenses Expense[]
  milkLogs MilkLog[]
  inventoryTransactions InventoryTransaction[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  WORKER
}

// =======================
// Multi-Tenant Core
// =======================
model Tenant {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  location       String?          @default("Kenya")
  phoneNumber    String?
  email          String?
  currencySymbol String           @default("KES")
  status         TenantStatus     @default(ACTIVE)
  plan           SubscriptionPlan @default(FREE_TRIAL)
  trialEndsAt    DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Tenant Relationships
  memberships    TenantUser[]
  animals        Animal[]
  milkLogs       MilkLog[]
  sales          Sale[]
  breedingEvents BreedingEvent[]
  healthRecords  HealthRecord[]
  inventoryItems InventoryItem[]
  expenses       Expense[]
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionPlan {
  FREE_TRIAL
  STANDARD
  PRO_ENTERPRISE
}

model TenantUser {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  role           Role       @default(WORKER)

  // Invitation Flow scoped to this tenant
  inviteToken    String?    @unique
  inviteTokenExp DateTime?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// =======================
// Animal Management
// =======================
model Animal {
  id          String       @id @default(cuid())
  tagNumber   String
  name        String?
  species     Species
  breed       String?
  dateOfBirth DateTime?
  gender      Gender
  status      AnimalStatus @default(ACTIVE)

  // Tenant Isolation
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Sale or Death details
  dateOfDeath  DateTime?
  causeOfDeath String?
  saleId       String?   @unique
  sale         Sale?     @relation(fields: [saleId], references: [id])

  // Genealogy / Breeding
  motherId   String?
  fatherName String? // Could be an external sire's name
  mother     Animal?  @relation("MotherOffspring", fields: [motherId], references: [id])
  offspring  Animal[] @relation("MotherOffspring")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Relations
  milkLogs       MilkLog[]
  healthRecords  HealthRecord[]
  breedingEvents BreedingEvent[] @relation("MotherBreeding")

  @@unique([tenantId, tagNumber])
  @@index([tenantId])
}

enum Species {
  DAIRY_COW
  INDIGENOUS_COW
  BULL
  HEIFER
  SHEEP
  GOAT
}

enum Gender {
  MALE
  FEMALE
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  SICK
}

// =======================
// Milk Production
// =======================
model MilkLog {
  id           String      @id @default(cuid())
  amountLiters Float
  milkingTime  MilkingTime
  date         DateTime    @default(now()) // Can be backdated if needed

  // Tenant Isolation
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
}

enum MilkingTime {
  MORNING
  EVENING
  OTHER
}

// =======================
// Sales Revenue
// =======================
model Sale {
  id        String   @id @default(cuid())
  saleType  SaleType
  amount    Float // Total revenue money
  quantity  Float? // e.g., Liters of milk or Number of animals
  date      DateTime @default(now())
  buyerName String?
  notes     String?

  // Tenant Isolation
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // If saleType is ANIMAL, link to the specific animal sold
  animal Animal?

  createdAt DateTime  @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
}

enum SaleType {
  MILK
  ANIMAL
  OTHER
}

// =======================
// Breeding & Calving
// =======================
model BreedingEvent {
  id           String            @id @default(cuid())
  date         DateTime // Date of mating/insemination
  eventType    BreedingEventType
  sireDetails  String? // Details/Name of the sire used
  expectedDate DateTime? // Expected birth date
  actualDate   DateTime? // Actual birth date
  notes        String?

  // Tenant Isolation
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  animalId String
  animal   Animal @relation("MotherBreeding", fields: [animalId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
}

enum BreedingEventType {
  INSEMINATION
  NATURAL_MATING
  PREGNANCY_CHECK
  BIRTH
}

// =======================
// Health & Medical
// =======================
model HealthRecord {
  id          String           @id @default(cuid())
  date        DateTime         @default(now())
  recordType  HealthRecordType
  description String
  cost        Float? // Optional: Track individual treatment costs

  // Tenant Isolation
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id])

  createdAt DateTime  @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
}

enum HealthRecordType {
  VACCINATION
  TREATMENT
  CHECKUP
}

// =======================
// Inventory & Expenses
// =======================
model InventoryItem {
  id           String            @id @default(cuid())
  name         String
  category     InventoryCategory
  quantity     Float
  unit         String // e.g., kg, bales, bottles
  minThreshold Float? // Alert if quantity drops below this

  // Tenant Isolation
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transactions InventoryTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
}

enum InventoryCategory {
  FEED
  MEDICINE
  EQUIPMENT
  OTHER
}

model InventoryTransaction {
  id       String          @id @default(cuid())
  type     TransactionType
  quantity Float // Amount added or removed
  date     DateTime        @default(now())
  notes    String?

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  amount      Float
  date        DateTime        @default(now())
  description String?

  // Tenant Isolation
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  createdAt DateTime  @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  @@index([tenantId])
}

enum ExpenseCategory {
  INVENTORY_PURCHASE
  LABOR
  VET_SERVICES
  MAINTENANCE
  OTHER
}

// =======================
// Farm Profile & Settings
// =======================
model FarmSetting {
  id             String   @id @default("default")
  farmName       String   @default("Premier Farm")
  location       String   @default("Nakuru County, Kenya")
  phoneNumber    String?  @default("+254 700 000 000")
  email          String?  @default("info@premierfarm.com")
  currencySymbol String   @default("KES")
  updatedAt      DateTime @updatedAt
}
